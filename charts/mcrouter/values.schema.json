{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "clusterSuffix": {
            "type": "string"
        },
        "commonLabels": {
            "type": "object"
        },
        "config": {
            "type": "string"
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "daemonset": {
            "type": "object",
            "properties": {
                "hostPort": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                }
            }
        },
        "deploymentType": {
            "type": "string",
            "enum": [
                "StatefulSet",
                "DaemonSet"
            ]
        },
        "extraArgs": {
            "type": "array"
        },
        "extraEnvVars": {
            "type": "array"
        },
        "extraObjects": {
            "type": "array"
        },
        "extraVolumeMounts": {
            "type": "array"
        },
        "extraVolumes": {
            "type": "array"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "image": {
            "type": "object",
            "required": [
                "repository"
            ],
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "enum": [
                        "",
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "registry": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "failureThreshold": {
                    "type": "integer"
                },
                "initialDelaySeconds": {
                    "type": "integer"
                },
                "periodSeconds": {
                    "type": "integer"
                },
                "successThreshold": {
                    "type": "integer"
                },
                "timeoutSeconds": {
                    "type": "integer"
                }
            }
        },
        "memcached": {
            "type": "object",
            "properties": {
                "config": {
                    "type": "object",
                    "properties": {
                        "maxConnections": {
                            "type": "integer"
                        },
                        "memoryLimit": {
                            "type": "integer"
                        }
                    }
                },
                "deploymentType": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "pdb": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "minAvailable": {
                            "type": "string"
                        }
                    }
                },
                "replicaCount": {
                    "type": "integer"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "clusterIP": {
                            "type": "string"
                        },
                        "publishNotReadyAddresses": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "metrics": {
            "type": "object",
            "properties": {
                "container": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "integer",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "podMonitor": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "honorLabels": {
                            "type": "boolean"
                        },
                        "interval": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object"
                        },
                        "metricRelabelings": {
                            "type": "array"
                        },
                        "relabelings": {
                            "type": "array"
                        },
                        "scrapeTimeout": {
                            "type": "string"
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object"
        },
        "pdb": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "minAvailable": {
                    "type": [
                        "integer",
                        "string"
                    ]
                }
            }
        },
        "podAnnotations": {
            "type": "object"
        },
        "podLabels": {
            "type": "object"
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "port": {
            "type": "integer",
            "maximum": 65535,
            "minimum": 1
        },
        "priorityClassName": {
            "type": "string"
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "failureThreshold": {
                    "type": "integer"
                },
                "initialDelaySeconds": {
                    "type": "integer"
                },
                "periodSeconds": {
                    "type": "integer"
                },
                "successThreshold": {
                    "type": "integer"
                },
                "timeoutSeconds": {
                    "type": "integer"
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "clusterIP": {
                    "type": "string"
                },
                "externalTrafficPolicy": {
                    "type": "null"
                },
                "port": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "automountServiceAccountToken": {
                    "type": "boolean"
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "statefulset": {
            "type": "object",
            "properties": {
                "antiAffinity": {
                    "type": "string",
                    "enum": [
                        "soft",
                        "hard"
                    ]
                },
                "replicas": {
                    "type": "integer"
                }
            }
        },
        "tmpfs": {
            "type": "object",
            "properties": {
                "medium": {
                    "type": "string",
                    "enum": [
                        "",
                        "Memory"
                    ]
                },
                "runtimeSizeLimit": {
                    "type": "string"
                },
                "spoolSizeLimit": {
                    "type": "string"
                }
            }
        },
        "tolerations": {
            "type": "array"
        }
    },
    "additionalProperties": true
}
